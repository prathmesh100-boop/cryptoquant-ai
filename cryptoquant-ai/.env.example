# CryptoQuant AI configuration. Copy to .env and edit. NEVER commit .env.
# All variables use the CQ_ prefix. Nested settings use a double underscore.

# Execution mode: BACKTEST | PAPER | DEMO | LIVE   (default PAPER)
CQ_MODE=PAPER

# LIVE additionally requires this to be explicitly true. Leave false.
CQ_LIVE_TRADING_CONFIRMED=false

# Lists are JSON arrays
CQ_SYMBOLS=["BTCUSD","ETHUSD"]
CQ_TIMEFRAMES=["15m","1h","4h"]

CQ_PAPER_INITIAL_EQUITY=10000
CQ_DATABASE_URL=sqlite:///data/cryptoquant.db
CQ_LOG_LEVEL=INFO
CQ_LOG_JSON=true

# Risk (research defaults, NOT safety guarantees). Percent values.
CQ_RISK__RISK_PER_TRADE_PCT=0.5
CQ_RISK__DAILY_LOSS_LIMIT_PCT=2.0
CQ_RISK__WEEKLY_LOSS_LIMIT_PCT=4.0
CQ_RISK__MAX_CONCURRENT_POSITIONS=1
CQ_RISK__CONSECUTIVE_LOSS_PAUSE=3
CQ_RISK__KILL_SWITCH=false

# Exchange (Delta Exchange India). Public market data needs NO credentials.
# Leave URLs blank to use verified defaults:
#   REST  https://api.india.delta.exchange          (testnet: https://cdn-ind.testnet.deltaex.org)
#   WS    wss://public-socket.india.delta.exchange  (legacy socket.india.* endpoint is deprecated)
# NOTE: demo/testnet API keys only work with the testnet URL and vice versa.
CQ_EXCHANGE__NAME=delta_india
CQ_EXCHANGE__BASE_URL=
CQ_EXCHANGE__WS_URL=
CQ_EXCHANGE__API_KEY=your_api_key_here
CQ_EXCHANGE__API_SECRET=your_api_secret_here
